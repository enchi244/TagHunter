# Cloudflare Pages response headers (this file is not served to visitors).
# Rules that match the same URL get their headers merged, so every header below
# is set in exactly ONE rule. Do not repeat a header in a second rule.

/*
  # Only our own files, plus Lemon Squeezy's script and checkout iframe, may load or run.
  # - lemon.js sets inline style attributes and injects one <style> tag, hence the two
  #   narrow style-src-* relaxations. Script stays strict: no inline JS, no eval.
  # - To enable the email provider, add its https origin to connect-src (see README).
  Content-Security-Policy: default-src 'none'; script-src 'self' https://assets.lemonsqueezy.com; style-src 'self'; style-src-elem 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-src https://*.lemonsqueezy.com; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests
  # Force HTTPS for a year. (Add "; preload" only once every subdomain is HTTPS-only.)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  # Legacy twin of CSP frame-ancestors: nobody can frame this site (clickjacking).
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # Switch off browser features the site never uses. Payment is left alone on purpose:
  # the Lemon Squeezy checkout iframe needs it (it asks with allow="payment").
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), serial=(), usb=(), xr-spatial-tracking=()
  # same-origin-allow-popups keeps PayPal / 3-D Secure pop-ups from checkout working.
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none

# Fonts never change under the same name: cache for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS are not fingerprinted (no build step). "no-cache" means the browser re-checks
# every time (a cheap 304 when nothing changed), so visitors never see new HTML with old CSS.
/assets/css/*
  Cache-Control: no-cache
/assets/js/*
  Cache-Control: no-cache
/assets/img/*
  Cache-Control: public, max-age=86400

# Buyers-only page: keep it out of search engines, caches and shared proxies.
/thank-you
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
/thank-you/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
